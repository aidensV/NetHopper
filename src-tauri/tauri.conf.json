{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "nethopper",
  "version": "0.1.1",
  "identifier": "com.aidensv.nethopper",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "nethopper",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDExRDU0OUYwQTlBQkFBNDQKUldSRXFxdXA4RW5WRVJzQjNZK0tSQm4yZWQ4TTJGNE5qcmJtdGxaeWh6dENhdjRqTW42Nno3NkMK",
      "endpoints": [
        "https://github.com/aidensV/NetHopper/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}